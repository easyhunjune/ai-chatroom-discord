# Copy to .env (same folder as server.mjs) and fill in. Never commit .env.

# Discord bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# OpenCode Go API key (members with "provider": "go" in config.json)
OPENCODE_GO_API_KEY=

# Hive API key (members with "provider": "hive", e.g. DeepSeek)
HIVEAI_API_KEY=
